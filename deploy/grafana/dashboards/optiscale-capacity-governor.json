{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Prometheus-backed portfolio dashboard for one OptiScale predictive capacity run. Kubernetes requested/Ready counts and OptiScale forecast/safe-capacity values are not exported as Prometheus series in this lab.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "optiscale-prometheus"
      },
      "description": "Observed demo-api demand from the application's monotonic request counter. This is a visualization of telemetry, not a separate controller input.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Requests / second",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{namespace=\"optiscale-demo\",app=\"demo-api\"}[1m]))",
          "legendFormat": "demo-api request rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Demand RPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "optiscale-prometheus"
      },
      "description": "Configured demo-api p95 query in milliseconds. The red horizontal threshold is the sample OptiScaler SLO: 250ms.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Latency",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 250
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"optiscale-demo\",app=\"demo-api\"}[1m]))) * 1000",
          "legendFormat": "demo-api p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "p95 latency vs SLO",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "optiscale-prometheus"
      },
      "description": "Effective serving replicas use OptiScale's definition: count instances whose request rate exceeds 1 RPS over 30 seconds. A step from 2 to 3 makes the newly traffic-bearing replica visible. Requested Deployment replicas and Kubernetes Ready replicas are not available from the current Prometheus scrape configuration; inspect the Deployment with kubectl for those values.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Replicas",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "stepAfter",
            "lineWidth": 3,
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0,
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(sum by(instance) (rate(http_requests_total{namespace=\"optiscale-demo\",app=\"demo-api\"}[30s])) > 1) or vector(0)",
          "legendFormat": "Effective serving replicas",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Replica realization: effective-serving count",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "optiscale-prometheus"
      },
      "description": "Aggregate and hottest traffic-bearing demo-api concurrency-slot occupancy. The visible 15-slot threshold is the safe operating boundary (20 physical slots x 0.75 margin), not a Prometheus metric.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Occupied slots (slot-seconds/second)",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(http_concurrency_slot_seconds_total{namespace=\"optiscale-demo\",app=\"demo-api\"}[1m]))",
          "legendFormat": "Aggregate held-slot occupancy",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "max((sum by(instance) (rate(http_concurrency_slot_seconds_total{namespace=\"optiscale-demo\",app=\"demo-api\"}[1m]))) and on(instance) (sum by(instance) (rate(http_requests_total{namespace=\"optiscale-demo\",app=\"demo-api\"}[30s])) > 1))",
          "legendFormat": "Hottest traffic-bearing replica",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Concurrency slot occupancy",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "optiscale-prometheus"
      },
      "description": "Forecast demand and realized safe capacity are recorded in OptiScaler status/DecisionRecord, not exported as Prometheus time series. This truthful substitute shows successful and error RPS from application counters; no forecast or capacity series is fabricated.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Requests / second",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "clamp_min(sum(rate(http_requests_total{namespace=\"optiscale-demo\",app=\"demo-api\"}[1m])) - sum(rate(http_errors_total{namespace=\"optiscale-demo\",app=\"demo-api\"}[1m])), 0)",
          "legendFormat": "Successful RPS",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(http_errors_total{namespace=\"optiscale-demo\",app=\"demo-api\"}[1m]))",
          "legendFormat": "Error RPS",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Success / error RPS (forecast not exported)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "optiscale-prometheus"
      },
      "description": "Application-observed dependency latency. A healthy inventory and PostgreSQL-query p95 during the target prescale helps distinguish target demand from a downstream bottleneck; these metrics do not expose PostgreSQL internals.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "p95 latency",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 250
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"optiscale-demo\",app=\"inventory-service\"}[1m]))) * 1000",
          "legendFormat": "Inventory HTTP p95",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_request_duration_seconds_bucket{namespace=\"optiscale-demo\",app=\"inventory-service\"}[1m]))) * 1000",
          "legendFormat": "PostgreSQL query p95",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Dependency health",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "OptiScale",
    "Kubernetes",
    "Capacity"
  ],
